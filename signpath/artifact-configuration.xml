<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: the GitHub artifact is a ZIP containing one .exe -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
